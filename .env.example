# 复制此文件为 .env 并填入你的真实key
# cp .env.example .env

# 高德地图 - Web服务key（后端调POI/AOI接口用）
AMAP_BACKEND_KEY=your_amap_web_service_key_here

# 高德地图 - Web端JS API key（前端地图组件用）
AMAP_FRONTEND_KEY=your_amap_js_api_key_here
# 高德 JS API 1.4.15+ 起还需要 securityJsCode（在控制台同一应用下获取）
AMAP_FRONTEND_SECRET=your_amap_js_api_security_code_here

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认目标城市（可在前端切换）
DEFAULT_CITY=长沙

# 服务端口
PORT=8000
