# 复制此文件为 .env 再填。Windows: copy .env.example .env
#
# 默认配置是**完全零成本**的：腾讯 POI + 规则打分 + 天地图底图，
# 只需要申请 2 个免费 key（腾讯、天地图），不调用任何按量付费接口。
# 什么都不填服务也能启动，网页上会告诉你还差什么。
# ---------------------------------------------------------------

# ========== 1. POI 数据源（必填其一）==========
# auto = 哪个 key 配了用哪个，都配了优先腾讯
POI_PROVIDER=auto

# 【推荐】腾讯位置服务 —— 个人开发者免费 10,000 次/日
# 申请: https://lbs.qq.com/dev/console/key/manage
# 建 key 时勾选「WebServiceAPI」，域名白名单留空即可
TENCENT_KEY=

# 【备选】高德 Web服务 —— 个人开发者只有 10,000 次/月，且与 JS API 共享
# 申请: https://console.amap.com/dev/key/app （服务平台选「Web服务」）
AMAP_BACKEND_KEY=

# ========== 2. 地图底图 ==========
# tianditu = 天地图（国家官方，个人免费 10,000 次/日，需 key，合规）
# amap     = 高德瓦片（免 key、免配置，但属非官方公开的瓦片接口，个人自用）
# osm      = OpenStreetMap（免 key，国内访问较慢）
MAP_PROVIDER=tianditu

# 天地图 key（MAP_PROVIDER=tianditu 时需要）
# 申请: https://console.tianditu.gov.cn/api/key （类型选「浏览器端」）
TIANDITU_KEY=

# ========== 3. 用工需求打分引擎 ==========
# none        = 纯规则打分，零 key 零成本零延迟（默认，词库见 data/labor_keywords.txt）
# zhipu       = 智谱 GLM-4.7-Flash，永久免费  https://open.bigmodel.cn/usercenter/apikeys
# ollama      = 本地 Ollama，完全离线免费（先 ollama pull qwen3:8b）
# siliconflow = 硅基流动免费模型          https://cloud.siliconflow.cn/account/ak
# deepseek    = DeepSeek，按量付费        https://platform.deepseek.com
# custom      = 任意 OpenAI 兼容端点，需同时填 LLM_BASE_URL 和 LLM_MODEL
LLM_PROVIDER=none

# 用哪个云端模型就填哪家的 key；ollama / none 不用填
LLM_API_KEY=

# 只有 LLM_PROVIDER=custom 时才需要填，其他情况留空走各家默认值
LLM_BASE_URL=
LLM_MODEL=

# ========== 4. 业务参数 ==========
# 默认目标城市（前端可随时改）
DEFAULT_CITY=长沙

# 用工需求分 ≥ 这个值算"有需求"。调高=更严格，调低=更宽松
LABOR_THRESHOLD=60

# 没有商圈标注时，按多大的网格做空间聚类（米）
GRID_SIZE_M=800

# 服务端口
PORT=8000
